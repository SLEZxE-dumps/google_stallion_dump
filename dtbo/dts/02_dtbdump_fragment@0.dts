/dts-v1/;

/ {
	board_id = <0x61302>;
	board_rev = <0x10000>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			smpl-warn {
				samsung,pins = "gpa9-4";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x01>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2mpg14mfd@0 {
				compatible = "samsung,s2mpg14mfd";
				acpm-ipc-channel = <0x02>;
				acpm-speedy-channel = <0x00>;
				s2mpg14,wakeup = "enabled";
				reg = <0x1f>;
				interrupts = <0x00 0x4a 0x04 0x00>;
				interrupt-parent = <0xffffffff>;
				pinctrl-names = "default";
				pinctrl-0 = <0x01>;
				gpios = <0xffffffff 0x04 0x01 0xffffffff 0x00 0x00 0xffffffff 0x01 0x00 0xffffffff 0x02 0x00 0xffffffff 0x03 0x00 0xffffffff 0x02 0x00 0xffffffff 0x03 0x00>;
				#thermal-sensor-cells = <0x01>;
				smpl_warn_en = <0x01>;
				smpl_warn_vth = <0x03>;
				smpl_warn_hys = <0x01>;
				b2_ocp_warn_en = <0x01>;
				b2_ocp_warn_cnt = <0x00>;
				b2_ocp_warn_dvs_mask = <0x00>;
				b2_ocp_warn_lvl = <0x00>;
				b2_ocp_warn_debounce_clk = <0x03>;
				b3_ocp_warn_en = <0x01>;
				b3_ocp_warn_cnt = <0x00>;
				b3_ocp_warn_dvs_mask = <0x00>;
				b3_ocp_warn_lvl = <0x06>;
				b3_ocp_warn_debounce_clk = <0x03>;
				b7_ocp_warn_en = <0x01>;
				b7_ocp_warn_cnt = <0x00>;
				b7_ocp_warn_dvs_mask = <0x00>;
				b7_ocp_warn_lvl = <0x00>;
				b7_ocp_warn_debounce_clk = <0x03>;
				b2_soft_ocp_warn_en = <0x00>;
				b2_soft_ocp_warn_cnt = <0x00>;
				b2_soft_ocp_warn_dvs_mask = <0x00>;
				b2_soft_ocp_warn_lvl = <0x00>;
				b2_soft_ocp_warn_debounce_clk = <0x03>;
				b3_soft_ocp_warn_en = <0x00>;
				b3_soft_ocp_warn_cnt = <0x00>;
				b3_soft_ocp_warn_dvs_mask = <0x00>;
				b3_soft_ocp_warn_lvl = <0x06>;
				b3_soft_ocp_warn_debounce_clk = <0x03>;
				b7_soft_ocp_warn_en = <0x00>;
				b7_soft_ocp_warn_cnt = <0x00>;
				b7_soft_ocp_warn_dvs_mask = <0x00>;
				b7_soft_ocp_warn_lvl = <0x00>;
				b7_soft_ocp_warn_debounce_clk = <0x03>;
				buck_ocp_ctrl1 = <0xbb>;
				buck_ocp_ctrl2 = <0xbb>;
				buck_ocp_ctrl3 = <0xbb>;
				buck_ocp_ctrl4 = <0xbb>;
				buck_ocp_ctrl5 = <0xbb>;
				wtsr_en = <0x01>;
				coldrst_en = "disabled";
				smpl_en = "enabled";
				wtsr_timer_val = <0x07>;
				coldrst_timer_val = <0x03>;
				smpl_timer_val = <0x07>;
				sub_smpl_en = "disabled";
				check_jigon = <0x00>;
				init_time,sec = <0x00>;
				init_time,min = <0x00>;
				init_time,hour = <0x0c>;
				init_time,mday = <0x01>;
				init_time,mon = <0x00>;
				init_time,year = <0x7b>;
				init_time,wday = <0x00>;
				sel_vgpio = <0xc3 0x1d 0xe3 0x0c 0x63 0xd6 0xe1 0x47 0x4d 0x96 0x09>;
				phandle = <0x04>;

				regulators {

					BUCK1M {
						regulator-name = "S2MPG14_BUCK1";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x01>;
						schematic-name = "S1M_VDD_MIF";
						subsys-name = "MIF";
						buck_rail;
