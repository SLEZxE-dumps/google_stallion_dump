#
# Stallion sensor device configuration registry script for all stages.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-zuma-pro
#

?+0x130000:0xFFFF0000

#
# Buses
#

# I2C
+/dev/i2c/0
  bus_name=i2c0
  bus_index=0

# I3C
+/dev/i3c/1
  bus_name=i3c1
  bus_index=1

# SPI
+/dev/spi/2
  bus_name=spi2
  bus_index=2

#
# Sensors
#

# IMU (ICM45631)
+/dev/icm45631/0
  bus_name=i3c1
  bus_freq_hz=400000
  i3c_freq_hz=12300000
  i3c_push_pull_duty_cycle_pct=40
  bus_addr=0x69
  i3c_addr=0xa
  intr_id=46
  trigger_type=2
  priority=0
  spi_slew_rate_regval=5
  i3c_slew_rate_regval=5
  md_threshold=60
  md_duration_samples=1
  sd_threshold=60
  sd_timeout_ms=5000
  sd_batching_latency_ms=1000
  lowG_peak_threshold=848
  lowG_detect_timeout_ms=20
  lowG_debounce_timeout_ms=1000
+/dev/icm45631/0/accel
  orientation_transform=-1 2 -3
  avg_odr_25=25
  fac_cal_transform=0.99706 0.00532 -0.00179 -0.0042 0.9973 0.00166 0.00333 -0.0027 0.99728 0.03431 -0.05063 0.08075
  temp=33.86
  temp_sensitivity=0.00028 -0.00075 -0.00185
+/dev/icm45631/0/gyro
  orientation_transform=-1 2 -3
  avg_odr_25=25
  fac_cal_transform=1.00272 0.00515 -0.00177 -0.00557 1.00389 0.00259 0.00133 -0.00237 0.99795 -0.00194 -0.00264 0.0006
  temp=33.86158
  temp_sensitivity=-0.00003 -0.00002 0.00001
+/dev/icm45631/0/temp
+/dev/icm45631/0/motion_detect
+/dev/icm45631/0/stationary_detect
+/dev/icm45631/0/freefall_detect

# MAG 1 (MMC5616WA)
+/dev/mmc5616/0
  bus_name=i2c0
  bus_freq_hz=400000
  bus_addr=0x30
  priority=0
+/dev/mmc5616/0/mag
  orientation_transform=1 2 3
  fac_cal_transform=0.9731 -0.0050 -0.0018 0.0191 0.9763 -0.0023 -0.0063 -0.0052 1.0416 0 0 0

# BARO (SPL07003)
+/dev/spl07003/0
  bus_name=i2c0
  bus_freq_hz=400000
  bus_addr=0x77
  intr_id=47
  coeff_a=0.0
  coeff_b=-0.037239
+/dev/spl07003/0/baro
  name=SPL07003 Barometer
  fac_cal_transform=1.0 -0.23189
  temp=32.31681
  temp_sensitivity=0.00123
+/dev/spl07003/0/temp
  name=SPL07003 Temperature

# ALSP (TMD3743)
+/dev/tmd3743/0
  bus_name=i2c0
  bus_freq_hz=400000
  bus_addr=0x39
  intr_id=45
  intr_gpio_id=86
  anti_aliasing=1
  interlacing=1
  # Leakage model type to use to calculate display leakage.
  #  0 : Compensate Lux using weighted Luma.
  #  1 : Compensate Lux using legacy plus modified C-channel histogram.
  #  2 : Compensate calculated XYZ values.
  #  3 : Compensate CRGBW channels.
  leakage_model_type=3

+/dev/tmd3743/0/prox
  auto_baseline=1
  gain1=128
  gain2=1
  pulse_count=2
  pulse_len_us=32
  temp_coeff=0
  pdata_scale=3.019
  far_threshold=1500
  near_threshold=2100
  pdata_baseline=9832

+/dev/tmd3743/0/als
  x_scale=1.19583
  lux_scale=1.16411
  z_scale=1.05540
  x_crgbw_coefs=-37.408235 43.854591 129.513772 -9.300066 -2.601188
  lux_crgbw_coefs=-27.257599 26.672212 124.899590 0.132850 -1.952329
  z_crgbw_coefs=30.456540 -57.486146 -0.813766 132.762996 1.365894

  # Thresholds for C/G ratio used for CCT invalidation.
  c_g_ratio_lower_threshold=2.4
  c_g_ratio_upper_threshold=4.8

  # Alternate Lux equation parameters.
  # Format:
  #   per_chan_lux_coefs = <C_coef> <R_coef> <G_coef> <B_coef> <W_coef>
  #   c_g_ratio_modified_lux = r1 r2 r3 r4
  #      defined as:
  #      (C/G < r1) || (r4 < C/G)            =>  W-based  eq.
  #      (r1 < C/G < r2) || (r3 < C/G < r4)  =>  Weighted average between W-based and default eq.
  #      r2 < C/G < r3                       =>  Default eq.
  per_chan_lux_coefs=30 90 90 90 30
  c_g_ratio_modified_lux=2.0 2.4 4.8 5.2

  # Display PWM table and dependent parameters.
  pwm_hz=240
  vsync_delay_us=3991

  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=1270 4096
  itime_table_0=1600000 300000
  max_gain_table_0=7 7
  prox_delay_60hz_0=13000 13000
  prox_delay_120hz_0=6000 6000

  # Lux Filter parameters
  fast_filter_size=10
  slow_filter_size=100
  aod_fast_filter_size=3
  aod_slow_filter_size=3

  # Histogram Configuration.
  histo_enable=1
  # Display coordinates go from top left to bottom right.
  histo_roi_left=725
  histo_roi_top=50
  histo_roi_right=825
  histo_roi_bottom=150
  # The maximum brightness (DBV) value up to which histogram is active.
  # This value should match one of the itime_table_brightness values.
  histo_max_brightness=4096
  # Minimum change needed for a leakage value to be reported, i.e.,
  # min_change = MAX(min_change_value, current_leakage_val * min_change_rate)
  histo_min_change_value=0.01
  histo_min_change_rate=0.01
  # Histogram polling interval in ms.
  histo_polling_interval=50
  # Fallback luma value to use when histogram returns error (e.g., due to DRM).
  histo_fallback_luma=128.0

  ## Leakage calculator configuration.

  # Histo Luma matrix coefficients.
  # Format: histo_luma_matrix_<pwm_hz>_<n> = <start_DBV> <end_DBV> <<co-effs of luma-term matrix>>
  #         where: pwm_hz = PWM frequency; n = Luma matrix count.
  # The luma-term matrix applies for the given pwm_hz, when "start_DBV <= current_DBV <= end_DBV".
  histo_luma_matrix_240_0=0 1270 0.41128902 0.66588231 -0.07717133 0.72385436 0.38629663 -0.11015099 -0.31807155 1.46189995 -0.1438284 0.22015509 0.82318704 -0.04334213 0.41466191 0.64589815 -0.06056006
  histo_luma_matrix_240_1=1271 4096 0.53832733 0.41761491 0.04405775 0.777023 0.19878551 0.02419149 0.11002153 0.87478823 0.01519024 0.36618864 0.50857808 0.12523328 0.63297562 0.35841825 0.00860613

  # Histo Luma exponent table.
  # Format: histo_luma_exp = <DBV1 exponent1> <DBV2 exponent2> ... <DBV_n exponent_n>
  #         where: DBV1 < DBV2 < ... < DBV_n.
  # For current_DBV, "exponent_x" value from first pair satisfying "current_DBV <= DBV_x" is chosen.
  histo_luma_exp=4096 0.25

  # Histo DBV equations.
  # Format: histo_dbv_eq_<pwm_hz>_<channel_index>_<n> = <start_DBV> <end_DBV> <eq_type>
  #                                                     <<equation co-efficients>>
  #         where: pwm_hz = PWM freq; channel_index = Leakage channel index enumerated as CRGBW;
  #                n = DBV equation count.
  # The DBV-term equation applies for the given pwm_hz, for the given leakage channel,
  # when "start_DBV <= current_DBV <= end_DBV".
  histo_dbv_eq_240_0_0=0 0 0 0
  histo_dbv_eq_240_0_1=1 1270 0 2.7656809717881400E-01 9.8113771450558400E-04 -3.1155120628710800E-06 1.0313488732232500E-08 -1.6162278704185800E-11 1.1531453291358800E-14 -3.0272223121022800E-18
  histo_dbv_eq_240_0_2=1271 3395 0 2.5470707070707100E+00 -5.0868686868686900E-03 3.8698989898989900E-06 -1.2577777777777800E-09 1.5155555555555600E-13
  histo_dbv_eq_240_0_3=3396 4096 0 4.51545454545455000E-01 1.43318181818182000E-04
  histo_dbv_eq_240_1_0=0 0 0 0
  histo_dbv_eq_240_1_1=1 1270 0 2.9984073341141700E-01 5.4695764189521500E-04 -6.0778678084561000E-07 3.9248982430080600E-09 -8.1204262225159800E-12 6.6063324598749300E-15 -1.8534839947382000E-18
  histo_dbv_eq_240_1_2=1271 3395 0 2.7444897959183700E+00 -5.5159183673469400E-03 4.1902040816326500E-06 -1.3591836734693900E-09 1.6310204081632700E-13
  histo_dbv_eq_240_1_3=3396 4096 0 3.8441441441441400E-01 1.6072072072072100E-04
  histo_dbv_eq_240_2_0=0 0 0 0
  histo_dbv_eq_240_2_1=1 1270 0 2.4642284741570300E-01 1.5166949058453200E-03 -5.5024212015623800E-06 1.5186704581771200E-08 -2.0902407626656500E-11 1.3549385269763000E-14 -3.2911252668366300E-18
  histo_dbv_eq_240_2_2=1271 3395 0 2.6176344086021500E+00 -5.2868817204301100E-03 4.0146236559139800E-06 -1.3015053763440900E-09 1.5647311827957000E-13
  histo_dbv_eq_240_2_3=3396 4096 0 4.9339805825242700E-01 1.3165048543689300E-04
  histo_dbv_eq_240_3_0=0 0 0 0
  histo_dbv_eq_240_3_1=1 1270 0 2.6628097415824700E-01 1.0634802485997500E-03 -3.5023447883879700E-06 1.1708783163803000E-08 -1.8666034334871500E-11 1.3621580214611900E-14 -3.6881210292969900E-18
  histo_dbv_eq_240_3_2=1271 3395 0 2.6533333333333300E+00 -5.4790697674418600E-03 4.1333333333333300E-06 -1.3345736434108500E-09 1.6055813953488400E-13
  histo_dbv_eq_240_3_3=3396 4096 0 2.1577049180327900E-01 2.0481967213114800E-04
  histo_dbv_eq_240_4_0=0 0 0 0
  histo_dbv_eq_240_4_1=1 1270 0 2.8312447244436400E-01 8.0405119929787200E-04 -1.6909807374354400E-06 5.5608365280760600E-09 -8.6424851461493400E-12 5.9455586498445500E-15 -1.4600304188895900E-18
  histo_dbv_eq_240_4_2=1271 3395 0 2.4773626373626400E+00 -4.9714285714285700E-03 3.8030769230769200E-06 -1.2421978021978000E-09 1.5032967032967000E-13
  histo_dbv_eq_240_4_3=3396 4096 0 4.0385365853658500E-01 1.5565853658536600E-04

  # Golden value for fac-cal leakages.
  crgbw_leakage_at_dbv=240.0000 257.87 137.86 117.30 32.57 240.31 1270.0000 240.0000 214.48 113.58 96.42 29.92 202.24 3826.0000

+/dev/tmd3743/0/color
  filter_size=100
  on_change_delta=150
  freeze_cct_on_inaccurate_leakage=1

+/dev/tmd3743/0/spectral

# Display Info
+/dev/display_info/0
  # Link to ALS attached to this display.
  attached_alsp=/dev/tmd3743/0

# Touch (utd_ft3683u)
+/dev/ft3683u/0
  bus_name=spi2
  bus_freq_hz=10000000
  spi_mode=0
  spi_word_size=8
  cs_gpio=67
  gesture_type=3
  intr_id=14
  intr_type=3
  panel_height_pixel=2424
  panel_height_mm=146
  single_tap_min_x=91
  single_tap_max_x=989
  single_tap_min_y=179
  single_tap_max_y=2245
  single_tap_min_frame_count=3
  single_tap_max_frame_count=31
  single_press_motion_tolerance=255
  single_press_max_touch_size=40
  long_press_min_x=440
  long_press_max_x=640
  long_press_min_y=1656
  long_press_max_y=1856
  long_press_min_frame_count=1
  long_press_motion_tolerance_inner=255
  long_press_max_touch_size=40
  long_press_marginal_min_x=440
  long_press_marginal_max_x=640
  long_press_marginal_min_y=1656
  long_press_marginal_max_y=1856
  long_press_monitor_channel_min_tx=6
  long_press_monitor_channel_max_tx=9
  long_press_monitor_channel_min_rx=24
  long_press_monitor_channel_max_rx=27
  long_press_min_node_count=8
  long_press_motion_tolerance_outer=528
  send_lptw_to_kernel=1
  super_resolution_auto_scale=1

# TBN
+/tbn
  tbn_mode=2

# VSC.
+/vsc
  quick_pick_up_enable=1
  single_tap_enable=1
  long_press_enable=1

# Camera VSYNC
+/dev/camera_vsync/0 # rear
  intr_id=57
  intr_trigger_type=2
+/dev/camera_vsync/1 # front
  intr_id=58
  intr_trigger_type=2
+/dev/camera_vsync/2 # rear ultra-wide-angle
  intr_id=59
  intr_trigger_type=2

+/vsc/fusion_prox_voice_call
  # 0: Normal (fusion of Optical Prox with other sensors)
  # 1: Optical Prox Passthrough (skips all other fusion logic)
  # 2: Optical Prox Overwrite (runs fusion logic but outputs Optical Prox state)
  mode=0

  # Timeout when in Interactive and FalseFar state before switching to Near.
  # Default: 1000ms
  interactive_false_far_timeout_ms=1000

  # Horizontal angle between device and earth to enter and exit Interactive
  # state. Angles need to be less than 90 degrees, and exit >= enter.
  # Defaults: 45 (enter) and 50 (exit)
  interactive_thresh_angles=45 50

  # Minimum horizontal angle between device and earth to qualify a valid
  # To-Ear gesture. Should be larger than the interactive exit angle.
  # Default: 60
  to_ear_thresh_angle=60

  # Change in horizontal angle between device and earth to trigger a From-Ear
  # event. The initial angle to compare against is taken on a To-Ear event.
  # Default: 30
  from_ear_delta_thresh_angle=30

  # Prox PDATA scale factor to normalize the values.
  pdata_scale=0.0333

+/vsc/auto_brightness
  # float[3]={LuxToEnter, LuxToExit, RemappedLux}
  lux_remap=-1.0 -1.0 -1.0
  # float[3]={MinDelta, MaxDelta, LuxRatio}
  lux_debounce_up=1 5000 0.15
  lux_debounce_down=0.1 5000 0.1
  # ALS[2], RLS[2], Fusion[2], each containing <maxSampleAgeMsec> and <maxNumOfSamples>
  filter_configs=500 60 500 30 500 90

+/vsc/aad_prox
  # 0: Normal (fusion of Optical Prox with ultrasound presence detector)
  # 1: Optical Prox Passthrough (skips all other fusion logic)
  mode=1
